{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imt-mines-ales.example/schemas/evaluation-case.json",
  "title": "IMT Mines Ales RAG evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "split",
    "case_type",
    "language",
    "category",
    "turns",
    "expected_answer",
    "expected_facts",
    "relevant_source_ids",
    "allowed_citation_ids",
    "expected_tool_behavior",
    "review"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^eval-[0-9]{3}$"},
    "split": {"enum": ["development", "heldout"]},
    "case_type": {"enum": ["answerable", "unsupported", "multi_turn"]},
    "language": {"enum": ["en", "fr"]},
    "category": {"type": "string", "minLength": 1},
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "expected_answer": {"type": "string", "minLength": 1},
    "expected_facts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "relevant_source_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "allowed_citation_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "expected_tool_behavior": {
      "enum": ["search_required", "search_not_required", "search_then_refuse"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "notes"],
      "properties": {
        "status": {"const": "approved"},
        "reviewer": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    }
  }
}
